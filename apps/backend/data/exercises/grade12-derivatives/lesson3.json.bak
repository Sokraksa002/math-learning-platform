{
  "lessonId": "grade12-derivatives-lesson3",
  "exercises": [
    {
      "id": "ex-001",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 99",
      "choices": ["y' = 0", "y' = 99", "y' = 1", "y' = x"],
      "correctIndex": 0,
      "explanation": "ដេរីវេនៃចំនួនថេរគឺស្មើនឹង 0។"
    },
    {
      "id": "ex-002",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 3x",
      "choices": ["y' = 3", "y' = 3x", "y' = 0", "y' = x"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (ax)' = a នាំឱ្យ (3x)' = 3។"
    },
    {
      "id": "ex-003",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = x^5",
      "choices": ["y' = 5x^4", "y' = x^4", "y' = 5x^5", "y' = 4x^5"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (x^n)' = n*x^(n-1) នាំឱ្យ (x^5)' = 5x^4។"
    },
    {
      "id": "ex-004",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 1/x",
      "choices": ["y' = -1/x^2", "y' = 1/x^2", "y' = ln(x)", "y' = -1/x"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (1/x)' = -1/x^2។"
    },
    {
      "id": "ex-005",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 1/x^2",
      "choices": ["y' = -2/x^3", "y' = 2/x^3", "y' = -1/x^3", "y' = -2/x^2"],
      "correctIndex": 0,
      "explanation": "y = x^-2 នាំឱ្យ y' = -2x^-3 = -2/x^3។"
    },
    {
      "id": "ex-006",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = x+2",
      "choices": ["y' = 1", "y' = 2", "y' = x", "y' = 0"],
      "correctIndex": 0,
      "explanation": "(x+2)' = x' + 2' = 1 + 0 = 1។"
    },
    {
      "id": "ex-007",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = (x+1)^2",
      "choices": ["y' = 2(x+1)", "y' = 2x", "y' = x+1", "y' = 2x+1"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (u^n)' = n*u' * u^(n-1) នាំឱ្យ y' = 2(x+1)'(x+1) = 2(1)(x+1) = 2(x+1)។"
    },
    {
      "id": "ex-008",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 1/(x+1)",
      "choices": ["y' = -1/(x+1)^2", "y' = 1/(x+1)^2", "y' = -1/(x+1)", "y' = ln(x+1)"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (1/u)' = -u' / u^2 នាំឱ្យ y' = -(x+1)' / (x+1)^2 = -1 / (x+1)^2។"
    },
    {
      "id": "ex-009",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = sqrt(x)",
      "choices": ["y' = 1/(2*sqrt(x))", "y' = 2*sqrt(x)", "y' = 1/sqrt(x)", "y' = sqrt(x)/2"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (sqrt(x))' = 1/(2*sqrt(x))។"
    },
    {
      "id": "ex-010",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = (x+1)(x+5)",
      "choices": ["y' = 2x + 6", "y' = x + 6", "y' = 2x + 5", "y' = 2x"],
      "correctIndex": 0,
      "explanation": "y = x^2 + 6x + 5 នាំឱ្យ y' = 2x + 6។"
    },
    {
      "id": "ex-011",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = (x+1)/(x+5)",
      "choices": ["y' = 4/(x+5)^2", "y' = -4/(x+5)^2", "y' = 6/(x+5)^2", "y' = 1/(x+5)^2"],
      "correctIndex": 0,
      "explanation": "y' = [(x+1)'(x+5)-(x+1)(x+5)']/(x+5)^2 = (x+5-x-1)/(x+5)^2 = 4/(x+5)^2។"
    },
    {
      "id": "ex-012",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = e^x",
      "choices": ["y' = e^x", "y' = xe^(x-1)", "y' = 1/e^x", "y' = e"],
      "correctIndex": 0,
      "explanation": "ដេរីវេនៃអនុគមន៍អិចស្ប៉ូណង់ស្យែល e^x គឺនៅដដែល។"
    },
    {
      "id": "ex-013",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = e^(x+1)",
      "choices": ["y' = e^(x+1)", "y' = e^x", "y' = (x+1)e^x", "y' = 1"],
      "correctIndex": 0,
      "explanation": "y' = (x+1)' * e^(x+1) = 1 * e^(x+1) = e^(x+1)។"
    },
    {
      "id": "ex-014",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = 2^x",
      "choices": ["y' = 2^x * ln(2)", "y' = 2^x", "y' = x*2^(x-1)", "y' = ln(2)"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្ត (a^x)' = a^x * ln(a) នាំឱ្យ (2^x)' = 2^x * ln(2)។"
    },
    {
      "id": "ex-015",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = ln(x)",
      "choices": ["y' = 1/x", "y' = e^x", "y' = 1/ln(x)", "y' = x"],
      "correctIndex": 0,
      "explanation": "ដេរីវេនៃ ln(x) គឺ 1/x ចំពោះ x > 0។"
    },
    {
      "id": "ex-016",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = ln(x+1)",
      "choices": ["y' = 1/(x+1)", "y' = 1/x", "y' = x+1", "y' = -1/(x+1)^2"],
      "correctIndex": 0,
      "explanation": "y' = (x+1)' / (x+1) = 1 / (x+1)។"
    },
    {
      "id": "ex-017",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = sin(x)",
      "choices": ["y' = cos(x)", "y' = -cos(x)", "y' = sin(x)", "y' = -sin(x)"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្តដេរីវេត្រីកោណមាត្រ (sin x)' = cos x។"
    },
    {
      "id": "ex-018",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = cos(x)",
      "choices": ["y' = -sin(x)", "y' = sin(x)", "y' = cos(x)", "y' = -cos(x)"],
      "correctIndex": 0,
      "explanation": "តាមរូបមន្តដេរីវេត្រីកោណមាត្រ (cos x)' = -sin x។"
    },
    {
      "id": "ex-019",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = cos(2x+1)",
      "choices": ["y' = -2*sin(2x+1)", "y' = -sin(2x+1)", "y' = 2*sin(2x+1)", "y' = -2*cos(2x+1)"],
      "correctIndex": 0,
      "explanation": "y' = -(2x+1)' * sin(2x+1) = -2*sin(2x+1)។"
    },
    {
      "id": "ex-020",
      "question": "គណនាដេរីវេនៃអនុគមន៍: y = tan(x)",
      "choices": ["y' = 1 + tan^2(x)", "y' = cot(x)", "y' = 1/cos(x)", "y' = -tan^2(x)"],
      "correctIndex": 0,
      "explanation": "ដេរីវេនៃ tan(x) គឺ 1/cos^2(x) ឬ 1 + tan^2(x)។"
    }
  ]
