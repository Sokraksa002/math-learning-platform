  "exercises": [
    {
      "id": "ex-001",
      "question": "រកប្រភេទនៃអាស៊ីមតូត និងសង់ក្រាបនៃអនុគមន៍ y = (x + 1) / (x - 1)",
      "choices": [
        "អាស៊ីមតូតឈរ x=1, អាស៊ីមតូតដេក y=1",
        "អាស៊ីមតូតឈរ x=-1, អាស៊ីមតូតដេក y=-1",
        "អាស៊ីមតូតឈរ x=1, អាស៊ីមតូតទ្រេត y=x",
        "គ្មានអាស៊ីមតូត"
      ],
      "correctIndex": 0,
      "graphData": {
        "type": "rational",
        "equation": "f(x) = (x + 1) / (x - 1)",
