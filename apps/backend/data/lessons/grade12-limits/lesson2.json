{

"id": "grade12-limits-lesson2",
"chapterId": "grade12-limits",
  "titleKm": "លីមីតនៃអនុគមន៍",
  "content": {
    "blocks": [
      {
        "type": "text",
        "value": "មេរៀនទី២៖ លីមីតនៃអនុគមន៍ (ការពន្យល់លម្អិតបន្ថែម)"
      },
      {
        "type": "text",
        "value": "១. សញ្ញាណនៃលីមីត៖ លីមីតគឺជាការសិក្សាអំពីតម្លៃរបស់អនុគមន៍ f(x) នៅពេលដែល x ខិតទៅជិតតម្លៃណាមួយ (a) តែមិនមែនស្មើនឹង a នោះទេ។ វាជួយយើងឱ្យដឹងពីឥរិយាបថរបស់អនុគមន៍នៅចំណុចដែលមិនកំណត់។"
      },
      {
        "type": "text",
        "value": "២. របៀបដោះស្រាយលីមីតរាងមិនកំណត់ (Indeterminate Forms)៖"
      },
      {
        "type": "text",
        "value": "• រាង 0/0៖ ត្រូវបំបែកភាគយកនិងភាគបែងជាកត្តា រួចសម្រួលកត្តារួម (x - a) ចោល។"
      },
      {
        "type": "text",
        "value": "• រាង ∞/∞៖ ត្រូវទាញដឺក្រេខ្ពស់បំផុតជាកត្តារួម ទាំងភាគយកនិងភាគបែង រួចសម្រួល។"
      },
      {
        "type": "text",
        "value": "• រាង +∞ - ∞៖ ត្រូវប្រើកន្សោមឆ្លាស់ (ករណីមានរ៉ាឌីកាល់) ឬទាញកត្តារួមដែលមានដឺក្រេខ្ពស់។"
      },
      {
        "type": "text",
        "value": "៣. លីមីតអនុគមន៍ត្រីកោណមាត្រ (រូបមន្តគ្រឹះ)"
      },
      {
        "type": "formula",
        "value": "lim_{u\\to0} \\frac{\\sin u}{u} = 1"
      },
      {
        "type": "text",
        "value": "៤. លីមីតនៃអនុគមន៍អិចស្ប៉ូណង់ស្យែល (e) និង លោការីតត្នេពែ (ln)"
      },
      {
        "type": "formula",
        "value": "lim_{x\\to0} \\frac{e^x - 1}{x} = 1"
      },
      {
        "type": "formula",
        "value": "lim_{x\\to0} \\frac{\\ln(1+x)}{x} = 1"
      },
      {
        "type": "text",
        "value": "៥. លីមីតរាងមិនកំណត់ 1^∞"
      },
      {
        "type": "formula",
        "value": "lim_{x\\to\\infty}(1+\\frac{1}{x})^x = e"
      },
      {
        "type": "text",
        "value": "៦. ភាពជាប់នៃអនុគមន៍៖ អនុគមន៍ f ជាប់ត្រង់ a លុះត្រាតែលីមីតខាងឆ្វេង ស្មើនឹងលីមីតខាងស្តាំ និងស្មើនឹងតម្លៃអនុគមន៍ត្រង់ចំណុចនោះ។"
      },
      {
        "type": "formula",
        "value": "f(a)=lim_{x\\to a^-}f(x)=lim_{x\\to a^+}f(x)"
      },
      {
        "type": "text",
        "value": "លំហាត់គំរូ និង ដំណោះស្រាយ"
      },
      {
        "type": "text",
        "value": "1. គណនា A = lim(x→2) (x²-4)/(x-2)"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ 4"
      },
      {
        "type": "text",
        "value": "2. គណនា B = lim(x→0) (√(x+1)-1)/x"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ 1/2"
      },
      {
        "type": "text",
        "value": "3. គណនា C = lim(x→∞) (3x² - 5x + 1)/(2x² + 7)"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ 3/2"
      },
      {
        "type": "text",
        "value": "4. គណនា D = lim(x→0) sin(5x)/x"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ 5"
      },
      {
        "type": "text",
        "value": "5. គណនា E = lim(x→0) (e^{3x}-1)/x"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ 3"
      },
      {
        "type": "text",
        "value": "6. គណនា F = lim(x→∞) (1 + 2/x)^x"
      },
      {
        "type": "text",
        "value": "ចម្លើយ៖ e^2"
      }
    ]
  }
}