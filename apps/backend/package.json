{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "private": true,
  "description": "",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:integration": "NODE_ENV=test jest --runInBand src/integration --passWithNoTests",
    "coverage": "jest --coverage --passWithNoTests",
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:init": "prisma init",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "verify-seed": "tsx scripts/verifySeed.ts",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.19.2",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.4",
    "google-auth-library": "^10.6.2",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "prisma": "^6.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.3.3",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.3.3"
  }
}
